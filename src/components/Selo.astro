---
// Selo do Em Produção: o >_ do cabeçalho dentro de dois círculos, com
// "em produção AÍ" correndo em volta. Desenhado com a cor de acento do tema,
// então acompanha o claro e o escuro sem precisar de duas imagens.
interface Props {
  tamanho?: string;
}

const { tamanho = '11rem' } = Astro.props;
---

<svg
  class="selo"
  style={`--tamanho-selo: ${tamanho}`}
  viewBox="0 0 1080 1080"
  role="img"
  aria-label="Em Produção AÍ"
>
  <defs>
    <path id="selo-anel" d="M540,540 m-392,0 a392,392 0 1,1 784,0 a392,392 0 1,1 -784,0"></path>
  </defs>
  <circle cx="540" cy="540" r="470" fill="none" stroke="currentColor" stroke-width="8"></circle>
  <circle cx="540" cy="540" r="318" fill="none" stroke="currentColor" stroke-width="8"></circle>
  <text font-size="66" fill="currentColor" dominant-baseline="middle">
    <textPath href="#selo-anel" textLength="2440" lengthAdjust="spacing">
      em produção AÍ · em produção AÍ · em produção AÍ ·
    </textPath>
  </text>
  <g transform="translate(540,540) scale(5.2) translate(-34,-32)">
    <polyline
      points="8,8 32,32 8,56"
      fill="none"
      stroke="currentColor"
      stroke-width="5.2"
      stroke-linecap="square"
      stroke-linejoin="miter"
      stroke-miterlimit="10"></polyline>
    <line x1="42" y1="52" x2="60" y2="52" stroke="currentColor" stroke-width="5.2" stroke-linecap="square"
    ></line>
  </g>
</svg>

<style>
  .selo {
    display: block;
    width: var(--tamanho-selo);
    height: auto;
    color: var(--acento);
  }

  .selo text {
    font-family: var(--mono);
    font-weight: 800;
    letter-spacing: 0;
    text-transform: none;
  }
</style>
