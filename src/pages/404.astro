---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada" descricao="Esta página não existe." semIndexar>
  <section>
    <p class="rotulo">Erro 404</p>
    <h1>Essa página não está no ar</h1>
    <p class="texto-suave">
      O endereço não existe ou o conteúdo mudou de lugar. O arquivo da newsletter continua inteiro.
    </p>
    <p>
      <a class="botao botao-vazado" href="/newsletter/">Ir para o arquivo</a>
    </p>
  </section>
</Base>
